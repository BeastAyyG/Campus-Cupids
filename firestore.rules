rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── User Profiles ──
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ── Open to Talk Status ──
    match /status/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ── Chats ──
    match /chats/{chatId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow delete: if isAuthenticated()
          && resource.data.senderId == request.auth.uid;
      }

      // Typing subcollection
      match /typing/{userId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow write: if isOwner(userId);
      }
    }

    // ── Crushes ──
    match /crushes/{crushId} {
      allow read: if isAuthenticated()
        && (resource.data.senderUid == request.auth.uid
            || resource.data.targetEmail == request.auth.token.email);
      allow create: if isAuthenticated()
        && request.resource.data.senderUid == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.senderUid == request.auth.uid;
    }

    // ── Friendship Group Members ──
    match /groupMembers/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // ── Groups (metadata) ──
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();

      // Group messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
      }
    }

    // ── Blocked Users ──
    match /blocks/{blockId} {
      allow read: if isAuthenticated()
        && (resource.data.blockerId == request.auth.uid
            || resource.data.blockedId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.blockerId == request.auth.uid;
    }

    // ── Reports ──
    match /reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if false; // Admin only
    }

    // ── Notifications ──
    match /notifications/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow write: if isAuthenticated(); // Allow others to trigger notificatons (e.g. cloud functions or client-side triggers if secured)
      // Ideally notifications should be created via Cloud Functions to be 100% secure, 
      // but for client-side prototype we allow authenticated writes to other users' notif collections (with rate limits in app logic).
      // A stricter rule would be: allow create if request.resource.data.type in ['MESSAGE', 'LIKE', 'CRUSH']
      allow delete: if isOwner(userId);
    }

    // ── Campus Buzz ──
    match /buzz/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 280
        // Basic spam prevention: must have timestamp
        && request.resource.data.createdAt is timestamp;
      allow update: if isAuthenticated(); // For likes/comments count

      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId); // Only I can like/unlike as myself
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if isAuthenticated()
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
